# Syntax fixture for the RamShield SYNPROXY rule model.
# This is intentionally non-destructive and is consumed with `nft -c -f`.
table inet ramshield_synproxy_fixture {
    set conn_limit4 { type ipv4_addr; size 65536; flags dynamic; }
    set conn_limit6 { type ipv6_addr; size 65536; flags dynamic; }
    chain preraw {
        type filter hook prerouting priority raw; policy accept;
        iifname "eth0" meta nfproto ipv4 tcp flags syn tcp dport { 22, 53, 80, 443 } meter syn_rate4 { ip saddr limit rate over 50/second burst 100 packets } drop
        iifname "eth0" meta nfproto ipv6 tcp flags syn tcp dport { 22, 53, 80, 443 } meter syn_rate6 { ip6 saddr limit rate over 50/second burst 100 packets } drop
        iifname "eth0" tcp flags syn tcp dport { 22, 53, 80, 443 } limit rate over 2000/second burst 4000 packets drop
        iifname "eth0" tcp flags syn tcp dport { 22, 53, 80, 443 } notrack
    }
    chain input {
        type filter hook input priority filter; policy accept;
        iifname "eth0" tcp dport { 22, 53, 80, 443 } ct state invalid,untracked synproxy mss 1460 wscale 7 timestamp sack-perm
        iifname "eth0" tcp dport { 22, 53, 80, 443 } ct state new ct count over 16384 drop
        iifname "eth0" meta nfproto ipv4 tcp dport { 22, 53, 80, 443 } ct state new add @conn_limit4 { ip saddr ct count over 128 } drop
        iifname "eth0" meta nfproto ipv6 tcp dport { 22, 53, 80, 443 } ct state new add @conn_limit6 { ip6 saddr ct count over 128 } drop
        iifname "eth0" ct state invalid tcp dport { 22, 53, 80, 443 } drop
    }
}