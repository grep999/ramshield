[Unit]
Description=RamShield Autonomous Ingress Defense Daemon
Documentation=https://github.com/grep999/ramshield
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ramshield --config /etc/ramshield/config.toml
Restart=on-failure
RestartSec=5s
LimitNOFILE=65535

# Runtime user: dedicated service account, no shell.
User=ramshield
Group=ramshield

# Minimal capabilities for Aya eBPF/XDP. CAP_BPF + CAP_PERFMON cover
# map creation and program load; CAP_NET_ADMIN covers XDP attach and
# NIC-level operations. Everything else is denied.
AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_NET_RAW

# Sandboxing
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
# Kernel sysctls are managed by the host's sysctl.d configuration.
# The daemon only verifies their values before applying SYNPROXY rules.
ProtectKernelTunables=true
ProtectKernelModules=true
# Write access is restricted to these three locations:
#   /var/lib/ramshield  — WAL segments + checkpoint
#   /dev/shm            — CGNAT rule table shared with proxy readers
#   /sys/fs/bpf         — pinned BPF objects (if pinning is enabled)
ReadWritePaths=/var/lib/ramshield /dev/shm /sys/fs/bpf

# eBPF syscalls are denied by default seccomp on some distros; only open
# the few the program actually needs if your distro's systemd blocks them:
# SystemCallFilter=~@privileged @obsolete
# (Aya does not require bpf(2) at seccomp level when file capabilities
# handle CAP_BPF — leave the comment unless verified on your kernel.)

[Install]
WantedBy=multi-user.target