#### A. Lock-Free Concurrent `BlobStore` (Unix/Linux Optimized)

```rust
use crate::error::{Result, RsError};
use lz4_flex::{compress_prepend_size, decompress_size_prepended};
use std::fs::{File, OpenOptions};
use std::os::unix::fs::FileExt; // Enterprise: Lock-free pread/pwrite
use std::sync::atomic::{AtomicU64, Ordering};

pub struct BlobHandle {
    pub offset: u64,
    pub compressed_len: u32,
    pub original_len: u32,
}

pub struct BlobStore {
    file: File,
    cursor: AtomicU64,
}

impl BlobStore {
    pub fn open(path: &str) -> Result<Self> {
        let file = OpenOptions::new()
            .create(true)
            .read(true)
            .write(true)
            .open(path)?;
            
        let cursor = file.metadata()?.len();
        Ok(Self {
            file,
            cursor: AtomicU64::new(cursor),
        })
    }

    pub fn write(&self, data: &[u8]) -> Result<BlobHandle> {
        let compressed = compress_prepend_size(data);
        let comp_len = compressed.len() as u32;
        let orig_len = data.len() as u32;
        
        // Atomically reserve the offset space (Lock-free)
        let offset = self.cursor.fetch_add(comp_len as u64, Ordering::SeqCst);
        
        // Write concurrently without changing the global file cursor
        self.file.write_all_at(&compressed, offset)?;
        
        Ok(BlobHandle {
            offset,
            compressed_len: comp_len,
            original_len: orig_len,
        })
    }

    pub fn read(&self, h: &BlobHandle) -> Result<Vec<u8>> {
        let mut buf = vec![0u8; h.compressed_len as usize];
        // Read concurrently without acquiring mutexes
        self.file.read_exact_at(&mut buf, h.offset)?;
        decompress_size_prepended(&buf).map_err(|e| RsError::Serde(e.to_string()))
    }
}

```

#### B. Memory-Safe Pre-allocated `Store::insert`

```rust
    pub fn insert(
        &self,
        key: IpAddr,
        value: Value,
        ttl_secs: Option<u64>,
        ram_limit_bytes: usize,
    ) -> Result<()> {
        let expires_at = ttl_secs.map(|s| Instant::now() + Duration::from_secs(s));
        let is_blocked = value.is_blocked();
        let new_entry = Entry { value, expires_at, version: 0 };
        let entry_size = std::mem::size_of::<IpAddr>() + std::mem::size_of::<Entry>() + new_entry.value.heap_bytes();

        let old_size = if let Some(old) = self.inner.get(&key) {
            std::mem::size_of::<Entry>() + old.value.heap_bytes() + std::mem::size_of::<IpAddr>()
        } else {
            0
        };

        let net_growth = entry_size.saturating_sub(old_size);

        // Pre-allocate memory budget using a Lock-Free CAS loop
        if net_growth > 0 {
            let mut current = self.ram_bytes.load(Ordering::Relaxed);
            loop {
                if current + net_growth > ram_limit_bytes {
                    tracing::warn!("CapacityExceeded for key: {}", key);
                    return Err(RsError::CapacityExceeded {
                        limit_mb: ram_limit_bytes / (1024 * 1024),
                    });
                }
                match self.ram_bytes.compare_exchange_weak(
                    current, 
                    current + net_growth, 
                    Ordering::SeqCst, 
                    Ordering::Relaxed
                ) {
                    Ok(_) => break,
                    Err(x) => current = x,
                }
            }
        }

        // Now safe to insert
        let replaced = self.inner.insert(key, new_entry);
        
        // Update O(1) blocked tracking stats
        if is_blocked && replaced.as_ref().map_or(true, |old| !old.value.is_blocked()) {
            self.traffic.blocked_ips_count.fetch_add(1, Ordering::Relaxed);
        }

        self.total_inserts.fetch_add(1, Ordering::Relaxed);
        Ok(())
    }

