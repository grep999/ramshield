    pub fn append(&self, entry: &WalEntry) -> Result<()> {
        let raw = serde_json::to_vec(entry).map_err(|e| RsError::Serde(e.to_string()))?;
        let (payload, flags): (Vec<u8>, u8) = if self.compress && raw.len() > 64 {
            (compress_prepend_size(&raw), 0x01)
        } else {
            (raw, 0x00)
        };
        
        let plen = payload.len() as u32;
        
        // ENTERPRISE FIX: CRC covers length, flags, AND payload to prevent header corruption.
        let mut h = Crc32::new();
        h.update(&plen.to_le_bytes());
        h.update(&[flags]);
        h.update(&payload);
        let crc = h.finalize();

        let mut g = self.inner.lock().unwrap();
        g.writer.write_all(&MAGIC.to_le_bytes())?;
        g.writer.write_all(&plen.to_le_bytes())?;
        g.writer.write_all(&crc.to_le_bytes())?;
        g.writer.write_all(&[flags])?;
        g.writer.write_all(&payload)?;
        g.bytes += (HEADER + payload.len()) as u64;

        if self.sync {
            g.writer.flush()?;
            // sync_data() inside a lock is highly blocking, consider offloading to a 
            // dedicated background writer thread via mpsc for true enterprise scaling.
            g.writer.get_ref().sync_data()?; 
        }
        
        // ... Segment rotation logic ...
        Ok(())
    }

