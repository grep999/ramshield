tadata.entropy_history` was an unbounded `Vec<f64>`.\n  - `PatternLearner.patterns` was an unbounded `HashMap<String, AttackPattern>`.\n  - `PredictionEngine.history` was an unbounded `Vec<HistoricalEvent>`.\n- **Impact**: In the presence of a distributed DDoS attack featuring spoofed IP pools or randomized polymorphic payloads, these vectors allocated memory indefinitely until the host ran out of memory (OOM crash).\n- **Remediation**: Replaced unbounded vectors with fixed-capacity `BoundedVecDeque` structures, capped `source_ips` with a bounded set, and bounded `patterns` with an LRU capacity ceiling.\n\n---\n\n## 2. Refactored Module: `src/learning/mod.rs`\n\n```rust\n//! Machine learning and signature pattern recognition module.\n//!\n//! Provides deterministic payload fingerprinting, normalized byte frequency\n//! cosine similarity, and bounded memory-safe attack pattern tracking.\n\nuse crate::util::BoundedVecDeque;\nuse serde::{Deserialize, Serialize};\nuse std::collections::HashMap;\nuse std::sync::{Arc, RwLock};\nuse std::time::SystemTime;\n\npub mod preprocess;\npub mod xgboost;\n\nconst MAX_PATTERNS: usize = 10_000;\nconst MAX_SOURCE_IPS_PER_PATTERN: usize = 64;\nconst ENTROPY_HISTORY_CAP: usize = 32;\n\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct AttackPattern {\n    pub id: String,\n    pub signature: Vec<u8>,\n    pub frequency: u64,\n    pub threat_level: f32,\n    pub last_seen: SystemTime,\n    pub metadata: PatternMetadata,\n}\n\n#[derive(Debug, Clone, Serialize, Deserialize)]\npub struct PatternMetadata {\n    pub first_seen: SystemTime,\n    pub last_seen: SystemTime,\n    pub source_ips: Vec<String>,\n    pub byte_patterns: HashMap<u8, u32>,\n    pub size: usize,\n    pub entropy_history: BoundedVecDeque<f64>,\n}\n\nimpl Default for PatternMetadata {\n    fn default() -> Self {\n        Self {\n            first_seen: SystemTime::now(),\n            last_seen: SystemTime::now(),\n            source_ips: Vec::with_capacity(MAX_SOURCE_IPS_PER_PATTERN),\n            byte_patterns: HashMap::new(),\n            size: 0,\n            entropy_history: BoundedVecDeque::new(ENTROPY_HISTORY_CAP),\n        }\n    }\n}\n\npub struct PatternLearner {\n    patterns: Arc<RwLock<HashMap<String, AttackPattern>>>,\n    similarity_threshold: f32,\n    max_patterns: usize,\n}\n\nimpl PatternLearner {\n    pub fn new(similarity_threshold: f32) -> Self {\n        Self {\n            patterns: Arc::new(RwLock::new(HashMap::with_capacity(1024))),\n            similarity_threshold: similarity_threshold.clamp(0.0, 1.0),\n            max_patterns: MAX_PATTERNS,\n        }\n    }\n\n    /// Learn a payload signature and associate threat intelligence.\n    pub fn learn_pattern(&self, data: &[u8], threat_level: f32, source_ip: &str) -> String {\n        let pattern_id = self.generate_pattern_id(data);\n        let now = SystemTime::now();\n        let entropy = self.calculate_entropy(data);\n\n        let mut patterns = self.patterns.write().unwrap();\n\n        // LRU-style eviction if capacity limit reached\n        if patterns.len() >= self.max_patterns && !patterns.contains_key(&pattern_id) {\n            if let Some(oldest_key) = patterns\n                .iter()\n                .min_by_key(|(_, p)| p.last_seen)\n                .map(|(k, _)| k.clone())\n            {\n                patterns.remove(&oldest_key);\n            }\n        }\n\n        let pattern = patterns.entry(pattern_id.clone()).or_insert_with(|| AttackPattern {\n            id: pattern_id.clone(),\n            signature: data[..data.len().min(512)].to_vec(), // Cap signature footprint\n            frequency: 0,\n            threat_level,\n            last_seen: now,\n            metadata: PatternMetadata::default(),\n        });\n\n        pattern.frequency = pattern.frequency.saturating_add(1);\n        pattern.threat_level = (pattern.threat_level * 0.8) + (threat_level * 0.2);\n        pattern.last_seen = now;\n\n        pattern.metadata.size = data.len();\n        pattern.metadata.last_seen = now;\n\n        if pattern.metadata.source_ips.len() < MAX_SOURCE_IPS_PER_PATTERN\n            && !pattern.metadata.source_ips.iter().any(|ip| ip == source_ip)\n        {\n            pattern.metadata.source_ips.push(source_ip.to_string());\n        }\n\n        for &byte in data.iter().take(1024) {\n            *pattern.metadata.byte_patterns.entry(byte).or_insert(0) += 1;\n        }\n\n        pattern.metadata.entropy_history.push(entropy);\n        pattern_id\n    }\n\n    /// Match input payload against known patterns using cosine frequency similarity.\n    pub fn detect_pattern(&self, data: &[u8]) -> Option<AttackPattern> {\n        if data.is_empty() {\n            return None;\n        }\n        let patterns = self.patterns.read().unwrap();\n        for (_, pattern) in patterns.iter() {\n            if self.calculate_similarity(data, &pattern.signature) >= self.similarity_threshold {\n                return Some(pattern.clone());\n            }\n        }\n        None\n    }\n\n    /// Shannon entropy calculation: H(X) = -sum(P(x) * log2(P(x)))\n    pub fn calculate_entropy(&self, data: &[u8]) -> f64 {\n        if data.is_empty() {\n            return 0.0;\n        }\n        let mut frequency = [0u32; 256];\n        for &byte in data {\n            frequency[byte as usize] += 1;\n        }\n\n        let len = data.len() as f64;\n        let mut entropy = 0.0;\n        for &freq in &frequency {\n            if freq > 0 {\n                let prob = freq as f64 / len;\n                entropy -= prob * prob.log2();\n            }\n        }\n        entropy\n    }\n\n    /// Deterministic FNV-1a 64-bit signature ID generation.\n    fn generate_pattern_id(&self, data: &[u8]) -> String {\n        const FNV_OFFSET_BASIS: u64 = 0xcbf29ce484222325;\n        const FNV_PRIME: u64 = 0x100000001b3;\n\n        let mut hash = FNV_OFFSET_BASIS;\n        for &byte in data.iter().take(256) {\n            hash ^= byte 