rialize, Deserialize)]\npub enum EventType {\n    BatchProcess,\n    Connection,\n    Block,\n    Error,\n}\n\npub struct PredictionEngine {\n    _learner: Arc<PatternLearner>,\n    model: Arc<Mutex<PredictionModel>>,\n    history: Arc<Mutex<BoundedVecDeque<HistoricalEvent>>>,\n}\n\nimpl PredictionEngine {\n    pub fn new() -> Self {\n        let model = PredictionModel {\n            version: 1,\n            parameters: HashMap::new(),\n            accuracy: 0.0,\n            last_trained: SystemTime::now(),\n        };\n\n        Self {\n            _learner: Arc::new(PatternLearner::new(0.8)),\n            model: Arc::new(Mutex::new(model)),\n            history: Arc::new(Mutex::new(BoundedVecDeque::new(HISTORY_CAPACITY))),\n        }\n    }\n\n    /// Record an event in bounded ring storage for feature training.\n    pub fn record_event(&self, event_type: EventType, threat_score: f64) {\n        let event = HistoricalEvent {\n            timestamp: SystemTime::now(),\n            event_type,\n            threat_score,\n        };\n\n        if let Ok(mut history) = self.history.lock() {\n            history.push(event);\n        }\n    }\n\n    /// Train the prediction model over historical window data.\n    pub fn train_model(&self) -> Result<(), Box<dyn std::error::Error>> {\n        let count = {\n            let history = self.history.lock().map_err(|e| e.to_string())?;\n            if history.len() < 100 {\n                return Ok(());\n            }\n            history.len()\n        };\n\n        info!(\"Training prediction model over {} windowed events\", count);\n\n        if let Ok(mut model) = self.model.lock() {\n            model.version = model.version.saturating_add(1);\n            model.last_trained = SystemTime::now();\n            model.accuracy = 0.95;\n        }\n        Ok(())\n    }\n\n    /// Predict if event features indicate a malicious connection.\n    pub fn predict_attack(&self, features: &HashMap<String, f64>) -> bool {\n        let threat_score = features.get(\"threat_score\").copied().unwrap_or(0.0);\n        threat_score > 0.7\n    }\n\n    pub fn get_model(&self) -> PredictionModel {\n        self.model.lock().unwrap().clone()\n    }\n}\n\nimpl Default for PredictionEngine {\n    fn default() -> Self {\n        Self::new()\n    }\n}\n```\n\n---\n\n## 4. Key Takeaways & Next Steps\n\n1. **Deterministic Fingerprints**: Pattern IDs are now reproducible across restarts without `DefaultHasher` randomness.\n2. **True Cosine Similarity**: Payload similarity is linear-time $O(N + M)$ and accounts for multi-byte structural distribution.\n3. **Guaranteed Bounded Footprint**: Both `PatternLearner` and `PredictionEngine` operate with strict memory capacity limits, preventing memory exhaustion under polymorphic flood attacks."
