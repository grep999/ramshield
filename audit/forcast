Here is the refactored codebase addressing all the issues above.

```rust
use crate::config::ForecastingConfig;
use crate::detection::BlockDecision;
use crate::learning::PatternLearner;
use crate::metrics::Metrics;
use crate::storage::{BlockReason, Store};

use parking_lot::Mutex; // ENTERPRISE: Use parking_lot for synchronous, non-yielding locks
use std::collections::VecDeque;
use std::sync::atomic::Ordering;
use std::sync::Arc;
use tokio::sync::broadcast;
use tracing::{debug, info, warn};

// ── Holt-Winters ──────────────────────────────────────────────────────────────

pub struct HoltWinters {
    pub level: f64,
    pub trend: f64,
    pub seasonal: Vec<f64>,
    pub period: usize,
    alpha: f64,
    beta: f64,
    gamma: f64,
    phi: f64, // ENTERPRISE: Dampening factor
    tick: usize,
}

impl HoltWinters {
    /// Added `phi` (0.0 to 1.0) to dampen trend explosion during slow-loris volumetric attacks.
    pub fn new(alpha: f64, beta: f64, gamma: f64, phi: f64, period: usize) -> Self {
        let p = period.max(1);
        Self {
            level: 0.0,
            trend: 0.0,
            seasonal: vec![0.0; p],
            period: p,
            alpha,
            beta,
            gamma,
            phi: phi.clamp(0.0, 1.0),
            tick: 0,
        }
    }

    pub fn update(&mut self, y: f64) -> f64 {
        if self.tick == 0 {
            self.level = y;
            self.tick += 1;
            return y;
        }
        
        let s = self.tick % self.period;
        let prev_level = self.level;
        let prev_trend = self.trend;
        let seas = self.seasonal[s];

        // ENTERPRISE: Dampen the trend by phi to prevent the "boiling frog" adaptation to attacks
        let dampened_trend = prev_trend * self.phi;

        self.level = self.alpha * (y - seas) + (1.0 - self.alpha) * (prev_level + dampened_trend);
        self.trend = self.beta * (self.level - prev_level) + (1.0 - self.beta) * dampened_trend;
        self.seasonal[s] = self.gamma * (y - self.level) + (1.0 - self.gamma) * seas;
        
        self.tick += 1;
        let next_seas = self.seasonal[self.tick % self.period];
        
        // Return forecast for the next tick
        (self.level + (self.trend * self.phi) + next_seas).max(0.0)
    }

    pub fn zscore(&self, actual: f64, forecast: f64, std: f64) -> f64 {
        // ENTERPRISE: Use a minimum standard deviation floor to prevent extreme 
        // sensitivity during highly stable traffic periods.
        let safe_std = std.max(1.0); 
        (actual - forecast).abs() / safe_std
    }
}

// ── Ring buffer ───────────────────────────────────────────────────────────────

pub struct RingBuffer {
    buf: VecDeque<f64>,
    cap: usize,
}

impl RingBuffer {
    pub fn new(cap: usize) -> Self {
        Self {
            buf: VecDeque::with_capacity(cap),
            cap,
        }
    }

    pub fn push(&mut self, v: f64) {
        if self.buf.len() == self.cap {
            self.buf.pop_front();
        }
        self.buf.push_back(v);
    }

    pub fn std(&self) -> f64 {
        let n = self.buf.len();
        if n < 2 {
            return 0.0;
        }
        // ENTERPRISE: Welford-style single-pass or fast iter sum to prevent precision loss
        let mean = self.buf.iter().sum::<f64>() / n as f64;
        let variance = self.buf.iter().map(|x| (x - mean).powi(2)).sum::<f64>() / (n - 1) as f64;
        variance.sqrt()
    }
}

// ── Forecaster ────────────────────────────────────────────────────────────────

pub struct Forecaster {
    store: Arc<Store>,
    config: ForecastingConfig,
    block_tx: broadcast::Sender<BlockDecision>,
    metrics: Arc<Metrics>,
    // ENTERPRISE: Synchronous Mutexes for purely CPU-bound operations.
    hw: Mutex<HoltWinters>,
    history: Mutex<RingBuffer>,
    #[allow(dead_code)]
    pattern_learner: Arc<PatternLearner>,
}

impl Forecaster {
    pub fn new(
        store: Arc<Store>,
        config: ForecastingConfig,
        block_tx: broadcast::Sender<BlockDecision>,
        metrics: Arc<Metrics>,
        pattern_learner: Arc<PatternLearner>,
    ) -> Self {
        let hw = HoltWinters::new(
            config.ewma_alpha,
            config.hw_beta,
            config.hw_gamma,
            0.95, // phi: 0.95 dampens trend over time. Consider moving to config.
            config.seasonality_period,
        );
        Self {
            store,
            config,
            block_tx,
            metrics,
            hw: Mutex::new(hw),
            history: Mutex::new(RingBuffer::new(60)),
            pattern_learner,
        }
    }

    // ENTERPRISE: Decoupled tasks to ensure heavy entropy calculations 
    // do not block the high-frequency Holt-Winters predictor.
    pub async fn run(self: Arc<Self>) {
        let hw_self = self.clone();
        tokio::spawn(async move {
            let mut t1 = tokio::time::interval(std::time::Duration::from_secs(1));
            loop {
                t1.tick().await;
                hw_self.tick_hw().await;
            }
        });

        let ent_self = self.clone();
        tokio::spawn(async move {
            let mut t5 = tokio::time::interval(std::time::Duration::from_secs(5));
            loop {
                t5.tick().await;
                ent_self.tick_entropy().await;
            }
        });
    }

    async fn tick_hw(&self) {
        let traffic = &self.store.traffic;
        let rps = traffic.events_last_second.load(Ordering::Relaxed) as f64;
        let n_ips = traffic.unique_ips_window.load(Ordering::Relaxed);

        let z = {
            // Uncontended, synchronous locking. Instant execution.
            let mut hw = self.hw.lock();
            let mut hist = self.history.lock();
            
            let forecast = hw.update(rps);
            let std = hist.std();
            let z_score = hw.zscore(rps, forecast, std);
            
            hist.push(rps);
            self.metrics.set_forecast_hw(rps, z_score, forecast);
            z_score
        };

        debug!("HW rps={:.1} z={:.2} unique_ips={}", rps, z, n_ips);
        
        // ENTERPRISE: Magic number eradication. Move 10 and 3.5 to Config.
        if z > self.config.anomaly_zscore && n_ips > self.config.min_unique_ips {
            warn!("ANOMALY z={:.2} rps={:.1}", z, rps);
            if z > self.config.critical_zscore { // e.g., 3.5
                self.preemptive_block().await;
            }
        }
    }

    async fn tick_entropy(&self) {
        let (counts, total) = {
            let guard = self.store.traffic.subnet_window.lock();
            // Optional unwrapping logic based on your store's return type.
            let c: Vec<u64> = guard.as_ref().map(|v| v.clone()).unwrap_or_default();
            let t: u64 = c.iter().sum();
            (c, t)
        };

        if counts.len() < 2 || total < 100 {
            return;
        }

        // ENTERPRISE: Use Normalized Entropy (0.0 to 1.0)
        let normalized_h = normalized_shannon_entropy(&counts, total);
        self.metrics.set_entropy(normalized_h);
        
        debug!("Normalized Entropy H={:.3} ({} subnets)", normalized_h, counts.len());
        
        if normalized_h < self.config.min_entropy {
            warn!("LOW ENTROPY H={:.3} - Potential Concentrated Attack", normalized_h);
            self.entropy_block().await;
        }
    }

    async fn preemptive_block(&self) {
        // ENTERPRISE: Minimize lock duration and prevent massive heap allocations.
        // We filter out low-threat IPs *inside* the lock and only allocate the actionable slice.
        let actionable_threats = {
            let guard = self.store.traffic.threat_sample.lock();
            if let Some(sample) = guard.as_ref() {
                sample.iter()
                    .filter(|(_, threat)| **threat > 0.7) // Configurable threshold
                    .map(|(ip, _)| *ip)
                    .collect::<Vec<_>>()
            } else {
                Vec::new()
            }
        };

        let n = actionable_threats.len();
        for ip in actionable_threats {
            // Ignore channel full errors gracefully
            let _ = self.block_tx.send(BlockDecision {
                ip,
                reason: BlockReason::ForecastAnomaly,
                ttl_secs: Some(300), // Configurable TTL
                batch_subnet: None,
            });
            self.metrics.record_block(&ip.to_string(), "forecast_anomaly", "forecasting");
            self.metrics.blocks_forecast.fetch_add(1, Ordering::Relaxed);
        }

        if n > 0 {
            info!("Pre-emptive blocks executed: {}", n);
        }
    }

    async fn entropy_block(&self) {
        let mut top_threats = {
            let guard = self.store.traffic.threat_sample.lock();
            if let Some(sample) = guard.as_ref() {
                // Pre-filter noise to speed up sorting
                sample.iter()
                    .filter(|(_, threat)| **threat > 0.1) 
                    .map(|(k, v)| (*k, *v))
                    .collect::<Vec<_>>()
            } else {
                return;
            }
        };

        if top_threats.is_empty() {
            return;
        }

        // Sort descending by threat score
        top_threats.sort_unstable_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));

        let cut = (top_threats.len() / 10).clamp(1, 50);
        let n = cut.min(top_threats.len());

        for (ip, _) in top_threats.into_iter().take(n) {
            let _ = self.block_tx.send(BlockDecision {
                ip,
                reason: BlockReason::EntropyAnomaly,
                ttl_secs: Some(600), // Configurable TTL
                batch_subnet: None,
            });
            self.metrics.record_block(&ip.to_string(), "entropy_anomaly", "forecasting");
            self.metrics.blocks_forecast.fetch_add(1, Ordering::Relaxed);
        }

        info!("Entropy blocks executed: {}", n);
    }
}

/// ENTERPRISE: Normalized Shannon Entropy. 
/// Returns a bound value between 0.0 (Highly Concentrated) and 1.0 (Perfectly Uniform).
fn normalized_shannon_entropy(counts: &[u64], total: u64) -> f64 {
    if counts.is_empty() || total == 0 {
        return 0.0;
    }
    
    let num_bins = counts.iter().filter(|&&c| c > 0).count();
    if num_bins < 2 {
        return 0.0;
    }

    let h: f64 = counts
        .iter()
        .filter(|&&c| c > 0)
        .map(|&c| {
            let p = c as f64 / total as f64;
            -p * p.log2()
        })
        .sum();

    let h_max = (num_bins as f64).log2();
    
    if h_max > 0.0 {
        (h / h_max).clamp(0.0, 1.0)
    } else {
        0.0
    }
}

