use tokio::{
    io::{AsyncReadExt, AsyncWriteExt},
    net::{TcpListener, TcpStream},
    sync::Semaphore,
    time::{timeout, Duration, Instant},
};
use tracing::{debug, error, info, warn};
use std::sync::Arc;
use std::sync::atomic::{AtomicU64, Ordering};
use crossbeam_channel::Sender;
use serde::{Deserialize, Serialize};

use crate::config::Config;
use crate::detection::ConnectionEvent;
use crate::engine::Engine;
use crate::storage::Store;
use super::{Request, Response};

/// Connection handling configuration
#[derive(Clone)]
struct ConnectionConfig {
    max_bytes: usize,
    read_timeout: Duration,
    write_timeout: Duration,
    idle_timeout: Duration,
}

impl ConnectionConfig {
    fn from_server(server: &IpcServer) -> Self {
        Self {
            max_bytes: server.max_connection_bytes,
            read_timeout: Duration::from_millis(server.read_timeout_ms),
            write_timeout: Duration::from_millis(server.write_timeout_ms),
            idle_timeout: Duration::from_millis(server.connection_idle_timeout_ms),
        }
    }
}

const DEFAULT_MAX_CONNECTION_BYTES: usize = 1_048_576; // 1MB per connection
const DEFAULT_READ_TIMEOUT_MS: u64 = 5000;
const DEFAULT_WRITE_TIMEOUT_MS: u64 = 5000;
const BATCH_MAX: usize = 4096;
const MAX_PAYLOAD_LENGTH: usize = 1_048_576; // 1MB max single payload
const CONNECTION_IDLE_TIMEOUT_MS: u64 = 30_000; // 30s idle

pub struct IpcServer {
    listener: TcpListener,
    engine: Arc<Engine>,
    event_tx: Sender<ConnectionEvent>,
    store: Arc<Store>,
    semaphore: Arc<Semaphore>,
    max_connections: usize,
    max_connection_bytes: usize,
    read_timeout_ms: u64,
    write_timeout_ms: u64,
    connection_idle_timeout_ms: u64,
    total_connections: Arc<AtomicU64>,
    active_connections: Arc<AtomicU64>,
    rejected_connections: Arc<AtomicU64>,
    dropped_events: Arc<AtomicU64>,
}

impl IpcServer {
    pub async fn bind(
        config: &Config,
        engine: Arc<Engine>,
        event_tx: Sender<ConnectionEvent>,
        store: Arc<Store>,
    ) -> std::io::Result<Self> {
        let addr = config.ipc.tcp_addr.clone();
        info!("IPC server binding to {addr} (Binary Protocol)");
        let listener = TcpListener::bind(&addr).await?;
        info!("IPC server bound to {addr}");

        let max_connections = config.ipc.max_connections.max(1);
        let max_connection_bytes = config.ipc.max_connection_bytes.unwrap_or(DEFAULT_MAX_CONNECTION_BYTES);
        let read_timeout_ms = config.ipc.read_timeout_ms.unwrap_or(DEFAULT_READ_TIMEOUT_MS);
        let write_timeout_ms = config.ipc.write_timeout_ms.unwrap_or(DEFAULT_WRITE_TIMEOUT_MS);
        let connection_idle_timeout_ms = config.ipc.connection_idle_timeout_ms.unwrap_or(CONNECTION_IDLE_TIMEOUT_MS);

        Ok(Self {
            listener,
            engine,
            event_tx,
            store,
            semaphore: Arc::new(Semaphore::new(max_connections)),
            max_connections,
            max_connection_bytes,
            read_timeout_ms,
            write_timeout_ms,
            connection_idle_timeout_ms,
            total_connections: Arc::new(AtomicU64::new(0)),
            active_connections: Arc::new(AtomicU64::new(0)),
            rejected_connections: Arc::new(AtomicU64::new(0)),
            dropped_events: Arc::new(AtomicU64::new(0)),
        })
    }

    pub async fn start(&self) {
        info!("IPC server listening (max_connections={}, max_bytes/conn={})", self.max_connections, self.max_connection_bytes);
        let mut backoff = Duration::from_millis(100);
        loop {
            if self.engine.is_shutting_down() {
                info!("IPC server initiating graceful shutdown");
                self.drain_connections().await;
                info!("IPC server shut down complete");
                break;
            }
            let accept = timeout(
                Duration::from_secs(1),
                self.listener.accept(),
            )
            .await;
            
            let (mut socket, remote) = match accept {
                Ok(Ok(pair)) => pair,
                Ok(Err(e)) => {
                    error!("accept error: {e}");
                    backoff = Duration::from_secs(1).min(backoff * 2);
                    tokio::time::sleep(backoff).await;
                    continue;
                }
                Err(_) => continue,
            };
            backoff = Duration::from_millis(100);

            let Ok(permit) = self.semaphore.clone().try_acquire_owned() else {
                self.engine.metrics.inc_rejected(1);
                self.rejected_connections.fetch_add(1, Ordering::Relaxed);
                warn!("Connection rejected from {remote}: semaphore exhausted ({})", self.max_connections);
                let _ = socket.shutdown().await;
                continue;
            };

            self.total_connections.fetch_add(1, Ordering::Relaxed);
            self.active_connections.fetch_add(1, Ordering::Relaxed);

            let engine = self.engine.clone();
            let event_tx = self.event_tx.clone();
            let store = self.store.clone();
            let config = ConnectionConfig::from_server(self);
            let active = self.active_connections.clone();
            let dropped = self.dropped_events.clone();

            tokio::spawn(async move {
                let _permit = permit;
                if let Err(e) = handle_connection(
                    socket,
                    engine,
                    event_tx,
                    store,
                    config,
                    dropped,
                ).await {
                    debug!("conn {remote} closed: {e}");
                }
                active.fetch_sub(1, Ordering::Relaxed);
            });
        }
    }

    async fn drain_connections(&self) {
        let start = Instant::now();
        while self.active_connections.load(Ordering::Relaxed) > 0 {
            if start.elapsed() > Duration::from_secs(30) {
                warn!("Shutdown timeout: {} connections still active", self.active_connections.load(Ordering::Relaxed));
                break;
            }
            tokio::time::sleep(Duration::from_millis(100)).await;
        }
    }

    pub fn stats(&self) -> IpcServerStats {
        IpcServerStats {
            total_connections: self.total_connections.load(Ordering::Relaxed),
            active_connections: self.active_connections.load(Ordering::Relaxed),
            rejected_connections: self.rejected_connections.load(Ordering::Relaxed),
            max_connections: self.max_connections as u64,
            dropped_events: self.dropped_events.load(Ordering::Relaxed),
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct IpcServerStats {
    pub total_connections: u64,
    pub active_connections: u64,
    pub rejected_connections: u64,
    pub max_connections: u64,
    pub dropped_events: u64,
}

async fn handle_connection(
    mut socket: TcpStream,
    engine: Arc<Engine>,
    event_tx: Sender<ConnectionEvent>,
    store: Arc<Store>,
    config: ConnectionConfig,
    dropped_events: Arc<AtomicU64>,
) -> Result<(), std::io::Error> {
    let mut total_bytes_read = 0usize;
    let mut last_activity = Instant::now();

    loop {
        if last_activity.elapsed() > config.idle_timeout {
            debug!("Connection idle timeout");
            return Ok(());
        }
        if total_bytes_read >= config.max_bytes {
            debug!("Connection exceeded max bytes ({})", config.max_bytes);
            return Ok(());
        }

        let mut len_buf = [0u8; 4];
        match timeout(config.read_timeout, socket.read_exact(&mut len_buf)).await {
            Ok(Ok(())) => {}
            Ok(Err(e)) if e.kind() == std::io::ErrorKind::UnexpectedEof => return Ok(()),
            Ok(Err(e)) => return Err(e),
            Err(_) => {
                debug!("Read timeout (length header)");
                return Ok(());
            }
        };

        let payload_len = u32::from_be_bytes(len_buf) as usize;
        if payload_len == 0 { continue; }
        if payload_len > MAX_PAYLOAD_LENGTH {
            warn!("Payload length exceeds maximum allowed: {payload_len}");
            return Ok(());
        }

        total_bytes_read += 4 + payload_len;
        last_activity = Instant::now();

        let mut payload = vec![0u8; payload_len];
        match timeout(config.read_timeout, socket.read_exact(&mut payload)).await {
            Ok(Ok(())) => {}
            Ok(Err(e)) => return Err(e),
            Err(_) => {
                debug!("Read timeout (payload)");
                return Ok(());
            }
        };

        let req: Request = match bincode::deserialize(&payload) {
            Ok(r) => r,
            Err(e) => {
                let resp = Response::Error { code: 1, message: format!("bincode parse error: {e}") };
                if timeout(config.write_timeout, write_resp(&mut socket, &resp)).await.is_err() {
                    debug!("Write timeout on error response");
                    return Ok(());
                }
                continue;
            }
        };

        engine.metrics.inc_requests();
        let ram_lim = engine.config.load().engine.ram_limit_mb.saturating_mul(1024 * 1024);
        
        let resp = process_request(
            req,
            &engine,
            &event_tx,
            &store,
            dropped_events.clone(),
            ram_lim,
        );

        if timeout(config.write_timeout, write_resp(&mut socket, &resp)).await.is_err() {
            debug!("Write timeout");
            return Ok(());
        }
    }
}

async fn write_resp(socket: &mut TcpStream, resp: &Response) -> Result<(), std::io::Error> {
    let bytes = bincode::serialize(resp).map_err(|e| {
        std::io::Error::new(std::io::ErrorKind::InvalidData, e)
    })?;

    let len = (bytes.len() as u32).to_be_bytes();
    socket.write_all(&len).await?;
    socket.write_all(&bytes).await?;
    Ok(())
}

fn epoch_ns() -> u64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .unwrap_or_default()
        .as_nanos() as u64
}

fn parse_ip(value: &str) -> Result<std::net::IpAddr, Response> {
    value.parse().map_err(|_| Response::Error {
        code: 400,
        message: format!("invalid IP address: {value}"),
    })
}

fn process_request(
    req: Request,
    engine: &Engine,
    event_tx: &Sender<ConnectionEvent>,
    store: &Store,
    dropped_events: Arc<AtomicU64>,
    ram_limit_bytes: usize,
) -> Response {
    match req {
        Request::CheckIp { ip } => {
            let parsed = match parse_ip(&ip) {
                Ok(ip) => ip,
                Err(resp) => return resp,
            };
            
            let status = store.get(&crate::storage::ip_key(parsed));
            match status {
                Some(crate::storage::Value::IpRecord(rec)) => {
                    let reason = match &rec.block_state {
                        crate::storage::BlockState::Blocked { reason, .. } => {
                            Some(reason.to_string())
                        }
                        _ => None,
                    };
                    Response::IpStatus {
                        ip,
                        blocked: matches!(
                            rec.block_state,
                            crate::storage::BlockState::Blocked { .. }
                        ),
                        threat: rec.threat_score,
                        ewma_rps: rec.ewma_rps,
                        reason,
                    }
                }
                _ => Response::IpStatus {
                    ip,
                    blocked: false,
                    threat: 0.0,
                    ewma_rps: 0.0,
                    reason: None,
                },
            }
        }
        Request::BlockIp {
            ip,
            reason,
            ttl_secs,
        } => {
            let parsed = match parse_ip(&ip) {
                Ok(ip) => ip,
                Err(resp) => return resp,
            };
            
            match store.set_blocked(
                parsed,
                crate::storage::BlockReason::ManualBlock,
                ttl_secs,
                ram_limit_bytes,
            ) {
                Ok(()) => {
                    engine.metrics.record_block(&ip, &reason, "manual");
                    Response::Ok {
                        message: format!("blocked {ip} reason={reason} ttl={ttl_secs:?}"),
                    }
                }
                Err(e) => Response::Error {
                    code: 507,
                    message: e.to_string(),
                },
            }
        }
        Request::UnblockIp { ip } => {
            let parsed = match parse_ip(&ip) {
                Ok(ip) => ip,
                Err(resp) => return resp,
            };
            
            if store.unblock(parsed) {
                Response::Ok {
                    message: format!("unblocked {ip}"),
                }
            } else {
                Response::Error {
                    code: 404,
                    message: format!("ip not tracked or not blocked: {ip}"),
                }
            }
        }
        Request::GetIpStats { ip } => {
            let parsed = match parse_ip(&ip) {
                Ok(ip) => ip,
                Err(resp) => return resp,
            };
            
            let key = crate::storage::ip_key(parsed);
            if let Some(crate::storage::Value::IpRecord(rec)) = store.get(&key) {
                Response::IpDetail(crate::ipc::IpDetail {
                    ip,
                    count: rec.request_count,
                    ewma_rps: rec.ewma_rps,
                    threat: rec.threat_score,
                    state: format!("{:?}", rec.block_state),
                    bytes_in: rec.bytes_in,
                    first_seen_s: rec.first_seen_ns / 1_000_000_000,
                    last_seen_s: rec.last_seen_ns / 1_000_000_000,
                })
            } else {
                Response::IpDetail(crate::ipc::IpDetail {
                    ip,
                    count: 0,
                    ewma_rps: 0.0,
                    threat: 0.0,
                    state: "not_tracked".into(),
                    bytes_in: 0,
                    first_seen_s: 0,
                    last_seen_s: 0,
                })
            }
        }
        Request::GetStats => {
            let stats = store.get_stats();
            Response::Stats(crate::ipc::Stats {
                ips_tracked: stats.ips_tracked,
                blocked: stats.blocked,
                ram_bytes: stats.ram_bytes,
                ram_limit_mb: stats.ram_limit_mb,
                uptime_secs: stats.uptime_secs,
                evictions: stats.evictions,
            })
        }
        Request::GetStatus => Response::Ok {
            message: "ok".into(),
        },
        Request::ReportConnection {
            ip,
            bytes,
            status_code,
            proto_fp,
        } => {
            let parsed = match parse_ip(&ip) {
                Ok(ip) => ip,
                Err(resp) => return resp,
            };
            
            let ev = ConnectionEvent {
                ip: parsed,
                timestamp_ns: epoch_ns(),
                bytes,
                status_code,
                proto_fingerprint: proto_fp,
            };
            
            match event_tx.try_send(ev) {
                Ok(()) => Response::Ok {
                    message: "accepted".into(),
                },
                Err(_) => {
                    engine.metrics.inc_rejected(1);
                    dropped_events.fetch_add(1, Ordering::Relaxed);
                    Response::BatchOk {
                        accepted: 0,
                        rejected: 1,
                    }
                }
            }
        }
        Request::ReportConnections { events } => {
            let now = epoch_ns();
            let mut accepted = 0u32;
            let mut rejected = 0u32;
            
            for cr in events {
                if accepted + rejected >= BATCH_MAX as u32 {
                    rejected = rejected.saturating_add(1);
                    continue;
                }
                
                let parsed = match cr.ip.parse::<std::net::IpAddr>() {
                    Ok(ip) => ip,
                    Err(_) => {
                        rejected += 1;
                        continue;
                    }
                };
                
                let ev = ConnectionEvent {
                    ip: parsed,
                    timestamp_ns: now,
                    bytes: cr.bytes,
                    status_code: cr.status_code,
                    proto_fingerprint: cr.proto_fp,
                };
                
                match event_tx.try_send(ev) {
                    Ok(()) => accepted += 1,
                    Err(e) => {
                        rejected += 1;
                        engine.metrics.inc_rejected(1);
                        dropped_events.fetch_add(1, Ordering::Relaxed);
                        debug!("tx full: {e:?}");
                    }
                }
            }
            
            debug!("report_connections: accepted={accepted} rejected={rejected}");
            Response::BatchOk { accepted, rejected }
        }
        Request::Flush => Response::Ok {
            message: "flush acknowledged (async)".into(),
        },
    }
}
