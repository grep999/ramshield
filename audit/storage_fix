pub const INLINE_MAX: usize = 64;

/// A zero-allocation key for the storage map to prevent heap overhead on IP lookups.
#[derive(Debug, Clone, Hash, Eq, PartialEq, Serialize, Deserialize)]
pub enum StoreKey {
    Ip(IpAddr),
    String(String),
}

impl StoreKey {
    pub fn heap_bytes(&self) -> usize {
        match self {
            Self::Ip(_) => 0,
            Self::String(s) => s.capacity(),
        }
    }
}

impl std::fmt::Display for StoreKey {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Ip(ip) => write!(f, "{ip}"),
            Self::String(s) => write!(f, "{s}"),
        }
    }
}

/// Stable store key for an IP — no longer allocates a String.
#[inline]
pub fn ip_key(ip: IpAddr) -> StoreKey {
    StoreKey::Ip(ip)
}

#[derive(Debug)]
pub struct TrafficCounters {
    pub events_last_second: AtomicU64,
    pub unique_ips_window: AtomicU64,
    pub promoted_ips: AtomicU64,
    pub subnet_window: Mutex<Vec<u64>>,
    pub threat_sample: Mutex<Vec<(IpAddr, f32)>>,
    pub ram_limit_mb: AtomicUsize,
    pub uptime_secs: AtomicU64,
}

impl TrafficCounters {
    pub fn new() -> Self {
        Self {
            events_last_second: AtomicU64::new(0),
            unique_ips_window: AtomicU64::new(0),
            promoted_ips: AtomicU64::new(0),
            subnet_window: Mutex::new(Vec::with_capacity(256)),
            threat_sample: Mutex::new(Vec::with_capacity(128)),
            ram_limit_mb: AtomicUsize::new(0),
            uptime_secs: AtomicU64::new(0),
        }
    }

    pub fn record_flush(&self, total_events: u64, unique_ips: u64, subnet_counts: &[u64]) {
        self.events_last_second.fetch_add(total_events, Ordering::Relaxed);
        self.unique_ips_window.store(unique_ips, Ordering::Relaxed);
        if let Ok(mut v) = self.subnet_window.lock() {
            v.clear();
            v.extend_from_slice(subnet_counts);
        }
    }

    pub fn get_and_reset_1s_rate(&self) -> u64 {
        self.events_last_second.swap(0, Ordering::Relaxed)
    }

    pub fn set_threat_sample(&self, sample: Vec<(IpAddr, f32)>) {
        if let Ok(mut v) = self.threat_sample.lock() {
            *v = sample;
        }
    }
}

impl Default for TrafficCounters {
    fn default() -> Self {
        Self::new()
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub enum Value {
    Counter(u64),
    Float(f64),
    Inline(Vec<u8>),
    Blob(Vec<u8>),
    IpRecord(IpRecord),
    SubnetRecord(SubnetRecord),
}

impl Value {
    pub fn from_bytes(bytes: &[u8]) -> Self {
        if bytes.len() <= INLINE_MAX {
            Self::Inline(bytes.to_vec())
        } else {
            Self::Blob(bytes.to_vec())
        }
    }

    pub fn heap_bytes(&self) -> usize {
        match self {
            Self::Inline(v) => v.capacity() * std::mem::size_of::<u8>(),
            Self::Blob(v) => v.capacity() * std::mem::size_of::<u8>(),
            Self::IpRecord(rec) => rec.heap_bytes(),
            Self::SubnetRecord(_) | Self::Counter(_) | Self::Float(_) => 0,
        }
    }

    pub fn is_blocked(&self) -> bool {
        matches!(self, Self::IpRecord(rec) if rec.block_state != BlockState::Clean)
    }
}

impl IpRecord {
    pub fn heap_bytes(&self) -> usize {
        self.behavior_history_rps.capacity() * std::mem::size_of::<f64>()
            + self.behavior_history_threat.capacity() * std::mem::size_of::<f32>()
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct IpRecord {
    pub ip: IpAddr,
    pub request_count: u64,
    pub ewma_rps: f64,
    pub baseline_rps: f64,
    pub baseline_threat: f32,
    pub behavior_history_rps: BoundedVecDeque<f64>,
    pub behavior_history_threat: BoundedVecDeque<f32>,
    pub first_seen_ns: u64,
    pub last_seen_ns: u64,
    pub bytes_in: u64,
    pub status_dist: [u32; 5],
    pub proto_fingerprint: u32,
    pub country: [u8; 2],
    pub threat_score: f32,
    pub block_state: BlockState,
    pub asn: u32,
}

#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
pub enum BlockState {
    Clean,
    Suspicious,
    Blocked { reason: BlockReason, since_ns: u64 },
}

#[derive(Debug, Clone, Serialize, Deserialize, PartialEq)]
pub enum BlockReason {
    HighRps(u64),
    SubnetBatch,
    ForecastAnomaly,
    EntropyAnomaly,
    ManualBlock,
}

impl std::fmt::Display for BlockReason {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::HighRps(r) => write!(f, "high_rps:{r}"),
            Self::SubnetBatch => write!(f, "subnet_batch"),
            Self::ForecastAnomaly => write!(f, "forecast_anomaly"),
            Self::EntropyAnomaly => write!(f, "entropy_anomaly"),
            Self::ManualBlock => write!(f, "manual"),
        }
    }
}

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct SubnetRecord {
    pub prefix: [u8; 3],
    pub active_ips: u32,
    pub blocked_ips: u32,
    pub total_rps: u64,
    pub threat_score: f32,
    pub last_updated_ns: u64,
}

#[derive(Debug, Clone)]
pub struct Entry {
    pub value: Value,
    pub expires_at: Option<Instant>,
    pub version: u64,
}

impl Entry {
    pub fn is_expired(&self) -> bool {
        self.expires_at.is_some_and(|e| Instant::now() > e)
    }
}

pub struct Store {
    inner: Arc<DashMap<StoreKey, Entry>>,
    subnet_table: Arc<DashMap<u32, SubnetRecord>>,
    subnet_index: Arc<DashMap<u32, DashSet<IpAddr>>>,
    ram_bytes: Arc<AtomicUsize>,
    pub traffic: Arc<TrafficCounters>,
    pub total_inserts: Arc<AtomicU64>,
    pub total_evictions: Arc<AtomicU64>,
}

impl Store {
    pub fn new(shard_count: usize) -> Self {
        let shards = shard_count.next_power_of_two();
        tracing::debug!("Store::new - Initializing store with {shards} shards");
        Self {
            inner: Arc::new(DashMap::with_shard_amount(shards)),
            subnet_table: Arc::new(DashMap::with_shard_amount(32)),
            subnet_index: Arc::new(DashMap::with_shard_amount(32)),
            ram_bytes: Arc::new(AtomicUsize::new(0)),
            traffic: Arc::new(TrafficCounters::new()),
            total_inserts: Arc::new(AtomicU64::new(0)),
            total_evictions: Arc::new(AtomicU64::new(0)),
        }
    }

    pub fn merge_subnet_window(&self, key: u32, prefix: [u8; 3], events: u32, now_ns: u64) {
        let mut rec = self
            .subnet_table
            .get(&key)
            .map(|e| e.value().clone())
            .unwrap_or(SubnetRecord {
                prefix,
                active_ips: 0,
                blocked_ips: 0,
                total_rps: 0,
                threat_score: 0.0,
                last_updated_ns: now_ns,
            });
        rec.total_rps = rec.total_rps.saturating_add(u64::from(events));
        rec.last_updated_ns = now_ns;
        self.subnet_table.insert(key, rec);
    }

    pub fn reset_subnet_window(&self, key: u32) {
        if let Some(mut e) = self.subnet_table.get_mut(&key) {
            e.total_rps = 0;
        }
    }

    pub fn insert(
        &self,
        key: StoreKey,
        value: Value,
        ttl_secs: Option<u64>,
        ram_limit_bytes: usize,
    ) -> Result<()> {
        let expires_at = ttl_secs.map(|s| Instant::now() + Duration::from_secs(s));
        let new_entry = Entry {
            value,
            expires_at,
            version: 0,
        };
        let entry_size = key.heap_bytes() + std::mem::size_of::<Entry>() + new_entry.value.heap_bytes();

        let old_size = self.inner.insert(key.clone(), new_entry).map_or(0, |old| {
            std::mem::size_of::<Entry>() + old.value.heap_bytes() + key.heap_bytes()
        });

        let current = self.ram_bytes.load(Ordering::Relaxed);
        if entry_size > old_size {
            let net_growth = entry_size - old_size;
            if old_size == 0 && current + net_growth > ram_limit_bytes {
                self.inner.remove(&key);
                tracing::warn!("Store::insert - CapacityExceeded for key: {key}");
                return Err(RamShieldError::CapacityExceeded {
                    limit_mb: ram_limit_bytes / (1024 * 1024),
                });
            }
            self.ram_bytes.fetch_add(net_growth, Ordering::Relaxed);
        } else if entry_size < old_size {
            self.ram_bytes.fetch_sub(old_size - entry_size, Ordering::Relaxed);
        }

        self.total_inserts.fetch_add(1, Ordering::Relaxed);
        Ok(())
    }

    pub fn get(&self, key: &StoreKey) -> Option<Value> {
        if let Some((_, e)) = self.inner.remove_if(key, |_, entry| entry.is_expired()) {
            let freed = key.heap_bytes() + std::mem::size_of::<Entry>() + e.value.heap_bytes();
            self.ram_bytes.fetch_sub(freed, Ordering::Relaxed);
            self.total_evictions.fetch_add(1, Ordering::Relaxed);
            return None;
        }
        self.inner.get(key).map(|e| e.value.clone())
    }

    pub fn set_blocked(
        &self,
        ip: IpAddr,
        reason: BlockReason,
        ttl_secs: Option<u64>,
        ram_limit_bytes: usize,
    ) -> Result<()> {
        let key = ip_key(ip);
        let now = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .unwrap_or_default()
            .as_nanos() as u64;
        
        let mut rec = match self.get(&key) {
            Some(Value::IpRecord(r)) => r,
            _ => IpRecord {
                ip,
                request_count: 0,
                ewma_rps: 0.0,
                baseline_rps: 0.0,
                baseline_threat: 0.0,
                behavior_history_rps: BoundedVecDeque::new(16),
                behavior_history_threat: BoundedVecDeque::new(16),
                first_seen_ns: now,
                last_seen_ns: now,
                bytes_in: 0,
                status_dist: [0; 5],
                proto_fingerprint: 0,
                country: [0; 2],
                threat_score: 1.0,
                block_state: BlockState::Clean,
                asn: 0,
            },
        };
        rec.block_state = BlockState::Blocked {
            reason,
            since_ns: now,
        };
        rec.last_seen_ns = now;
        self.insert(key, Value::IpRecord(rec), ttl_secs, ram_limit_bytes)
    }

    pub fn unblock(&self, ip: IpAddr) -> bool {
        let key = ip_key(ip);
        let Some(mut entry) = self.inner.get_mut(&key) else {
            return false;
        };
        if entry.is_expired() {
            return false;
        }
        if let Value::IpRecord(ref mut rec) = entry.value {
            if matches!(rec.block_state, BlockState::Blocked { .. }) {
                rec.block_state = BlockState::Clean;
                return true;
            }
        }
        false
    }

    pub fn update_subnet_index(&self, ip: IpAddr, subnet_key: Option<u32>, is_removal: bool) {
        let Some(sk) = subnet_key else { return; };

        if is_removal {
            if let Some(subnet_ips) = self.subnet_index.get(&sk) {
                subnet_ips.remove(&ip);
                if subnet_ips.is_empty() {
                    drop(subnet_ips);
                    self.subnet_index.remove_if(&sk, |_, ips| ips.is_empty());
                }
            }
        } else {
            self.subnet_index
                .entry(sk)
                .or_default()
                .insert(ip);
        }
    }

    pub fn get_ips_in_subnet(&self, subnet_key: u32) -> Vec<IpAddr> {
        self.subnet_index
            .get(&subnet_key)
            .map(|ips| ips.iter().map(|ip| *ip).collect())
            .unwrap_or_default()
    }
    
    pub fn inner(&self) -> &DashMap<StoreKey, Entry> {
        &self.inner
    }
}
