    "proto_cluster": "tcp_syn",
    "target_ip": "10.255.0.99",
    "burst_multiplier": 2.0,
    "workers": 16,
    "batch_size": 1500
  },
  "slowloris": {
    "description": "Slow/low: tiny batches, long jitter, low rate",
    "mode": "pareto_hot",
    "proto_cluster": "slow",
    "batch_size": 50,
    "jitter_ms": [
      80,
      250
    ],
    "burst_multiplier": 0.3,
    "workers": 12
  },
  "dns_amplification": {
    "description": "DNS amplification pattern, udp/dns fingerprints",
    "mode": "subnet",
