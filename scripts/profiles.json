    "subnet_concentration": 0.9,
    "workers": 16,
    "batch_size": 1200,
    "bytes_range": [
      512,
      4096
    ]
  },
  "botnet_entropy": {
    "description": "Distributed botnet, high entropy, mixed malware protos",
    "mode": "botnet",
    "proto_cluster": "mixed_malware",
    "entropy": "high",
