    "proto_cluster": "http",
    "hot_ip_ratio": 0.2,
    "subnet_concentration": 0.4,
    "burst_multiplier": 1.5,
    "workers": 24,
    "batch_size": 1000
  },
  "volumetric_syn": {
    "description": "TCP SYN volumetric: single-target saturation",
