{# k8s-deployment.yaml.j2 — rendered image-tag Deployment for local k8s apply #}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ramshield
  namespace: ramshield
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: ramshield
      app.kubernetes.io/component: server
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ramshield
        app.kubernetes.io/component: server
    spec:
      serviceAccountName: ramshield
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        runAsGroup: 65532
        fsGroup: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: ramshield
          image: {{ k8s_image | default('ghcr.io/grep999/ramshield') }}:{{ k8s_image_tag | default('0.6.0') }}
          imagePullPolicy: IfNotPresent
          args: ["--config", "/etc/ramshield/config.toml"]
          ports:
            - name: ipc
              containerPort: 7890
              protocol: TCP
            - name: dashboard
              containerPort: 9999
              protocol: TCP
          env:
            - name: RUST_LOG
              value: "info,ramshield=debug"
            - name: RAMSHIELD_DASHBOARD__ADMIN_PASSWORD_HASH
              valueFrom:
                secretKeyRef:
                  name: ramshield-admin
                  key: argon2-hash
                  optional: false
            - name: RAMSHIELD_IPC__AUTH_KEYS
              valueFrom:
                secretKeyRef:
                  name: ramshield-admin
                  key: ipc-auth-key
                  optional: false
          readinessProbe:
            httpGet:
              host: 127.0.0.1
              path: /healthz
              port: dashboard
            initialDelaySeconds: 2
            periodSeconds: 5
          startupProbe:
            httpGet:
              host: 127.0.0.1
              path: /healthz
              port: dashboard
            failureThreshold: 30
            periodSeconds: 10
          livenessProbe:
            httpGet:
              host: 127.0.0.1
              path: /livez
              port: dashboard
            initialDelaySeconds: 10
            periodSeconds: 30
            failureThreshold: 3
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: "500m"
              memory: "512Mi"
            limits:
              cpu: "2"
              memory: "2Gi"
          volumeMounts:
            - name: config
              mountPath: /etc/ramshield
              readOnly: true
            - name: wal
              mountPath: /var/lib/ramshield/wal
      volumes:
        - name: config
          configMap:
            name: ramshield-config
        - name: wal
          persistentVolumeClaim:
            claimName: ramshield-wal
